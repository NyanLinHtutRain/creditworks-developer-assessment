# Copy to .env and adjust before running `docker compose up`.
# .env is git-ignored; never commit real credentials.

# SQL Server administrator password.
# Must satisfy SQL Server complexity rules: 8+ characters with upper case,
# lower case, digits and symbols.
MSSQL_SA_PASSWORD=ChangeMe_Local123!

# Database the API connects to.
MSSQL_DATABASE=VehicleManager

# Host port mappings.
MSSQL_PORT=1433
API_PORT=8080
WEB_PORT=5173
